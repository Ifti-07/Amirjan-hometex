# ========================================================
# Server Configuration (server/.env or Cloud Service Env)
# ========================================================
PORT=3000
NODE_ENV=development # Set to 'production' on deploy

# MongoDB connection string (Atlas or self-hosted)
DB_URL=mongodb+srv://abduljabbardev_db_user:abduljabbardev_db_user@ifticlaster.apmkuui.mongodb.net/homtexDB?retryWrites=true&w=majority

# Strong random string for JWT authentication tokens
JWT_SECRET=supersecretkey_change_in_production

# Allowed frontend origin(s) for CORS.
# For single-service deployment (where server serves frontend): can be omitted or set to your domain.
# For separate frontend (e.g. Vercel): set to your frontend URL (e.g., https://your-site.vercel.app).
# Multiple URLs can be comma-separated: http://localhost:5173,https://your-site.vercel.app
CLIENT_URL=http://localhost:5173

# ========================================================
# Client Configuration (client/.env or Vercel/Netlify Env)
# ========================================================
# Local dev server proxy target
VITE_API_BASE_URL=http://localhost:3000

# Production API URL (Only needed if client is deployed separately on Vercel/Netlify)
# e.g.: https://your-server.onrender.com (the app automatically resolves /api/v1)
# Leave unset or empty for single-service deployment (defaults to same-origin /api/v1)
# VITE_API_URL=https://your-server.onrender.com

